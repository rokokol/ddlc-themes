# Generated by generate.sh from ddlc-palette's colours — do not edit
# Copy into ~/.config/matplotlib/stylelib/ and select it: plt.style.use("ddlc-dark")

# Three series, not five. The palette is polarised — the same reason base16 draws
# different accents per variant — and everything else either leaves the dark lightness
# band or falls under 3:1 on ink
axes.prop_cycle:  cycler('color', ['BB5599', 'CC0C29', '6868B4'])

figure.facecolor:  222222
savefig.facecolor: 222222
axes.facecolor:    222222
axes.edgecolor:    6C4681
grid.color:        6C4681

text.color:        FFFFFF
axes.labelcolor:   FFFFFF
axes.titlecolor:   FFFFFF
xtick.color:       B59CA1
ytick.color:       B59CA1
xtick.labelcolor:  FFFFFF
ytick.labelcolor:  FFFFFF

figure.dpi:          140
savefig.dpi:         140
savefig.bbox:        tight
font.family:         sans-serif
font.sans-serif:     Nunito, DejaVu Sans
font.size:           9
axes.titlesize:      11
axes.titleweight:    normal
axes.titlelocation:  left
axes.spines.top:     False
axes.spines.right:   False
axes.axisbelow:      True
grid.linewidth:      0.7
legend.frameon:      False
lines.linewidth:     1.8
